root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,axaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[*.cs]
# Style
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = false:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

# Analyzer noise reduction for an application (not a reusable library).
dotnet_diagnostic.CA1062.severity = none   # validate public args: nullable annotations cover this
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait: application code, no sync-context capture concerns
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates: not worth it for low-volume logs
dotnet_diagnostic.CA1873.severity = none   # log argument evaluation cost: low-volume logs
dotnet_diagnostic.CA1859.severity = none   # concrete return types: interfaces preferred at boundaries
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1303.severity = none   # literal strings in messages
dotnet_diagnostic.CA1031.severity = none   # catching general exceptions is deliberate at boundaries
dotnet_diagnostic.CA1002.severity = none   # List<T> in public API
dotnet_diagnostic.CA2227.severity = none   # collection setters (options binding)
dotnet_diagnostic.CA1034.severity = none   # nested types
dotnet_diagnostic.CA1819.severity = none   # arrays as properties (options binding)
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1515.severity = none   # make types internal: app assemblies are referenced by tests
dotnet_diagnostic.CA1812.severity = none   # uninstantiated internal classes (DI)
dotnet_diagnostic.CA1724.severity = none   # type names conflicting with namespaces
dotnet_diagnostic.CA1711.severity = none   # suffix rules
dotnet_diagnostic.CA1716.severity = none   # keyword identifiers
dotnet_diagnostic.CA1308.severity = none   # ToLowerInvariant for normalization is intended
dotnet_diagnostic.CA1861.severity = none   # constant arrays as arguments
dotnet_diagnostic.CA1024.severity = none   # use properties where appropriate
dotnet_diagnostic.CA1063.severity = none   # dispose pattern
dotnet_diagnostic.CA1001.severity = none   # singleton services owning a SemaphoreSlim live for the process
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1040.severity = none   # empty interfaces
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1720.severity = none   # identifiers containing type names (CellType.Decimal)
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA5350.severity = warning
dotnet_diagnostic.CA5351.severity = warning
dotnet_diagnostic.CA3075.severity = error   # insecure DTD processing
dotnet_diagnostic.CA3076.severity = error
dotnet_diagnostic.CA3077.severity = error
dotnet_diagnostic.CA5372.severity = error   # XmlReaderSettings XmlResolver

[**/tests/**.cs]
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.IDE0058.severity = none
