        { "id": "amount", "heading": "Amount", "cellType": "decimal", "width": 16, "numberFormat": "#,##0.00", "sensitivity": "restricted" },
        { "id": "currency", "heading": "Currency", "cellType": "text", "width": 10 },
        { "id": "direction", "heading": "Direction", "cellType": "text", "width": 10 },
        { "id": "status", "heading": "Status", "cellType": "text", "width": 12 },
        { "id": "counterpartyName", "heading": "Counterparty", "cellType": "text", "width": 30, "sensitivity": "sensitive", "allowInRejectionOutput": false },
