      "source": "t:TransactionId",
      "table": "transactions",
      "column": "transactionId",
      "required": true,
      "transforms": [ { "type": "upper" } ],
      "validation": { "minLength": 8, "maxLength": 64, "pattern": "[A-Z0-9-]+" }
