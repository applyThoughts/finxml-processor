<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FinXmlProcessor.Desktop.ViewModels"
             x:Class="FinXmlProcessor.Desktop.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" MinHeight="640">
    <TextBlock Grid.Row="0" Classes="h1" Text="History" />
    <TextBlock Grid.Row="1" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding ErrorMessage}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBox Width="260" Text="{Binding FilterText}" Watermark="Filter by file name" AutomationProperties.Name="Filter by file name" />
      <ComboBox Width="200" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" AutomationProperties.Name="Status filter" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <Button Content="Show workbook" Command="{Binding RevealOutputCommand}" CommandParameter="{Binding SelectedJob}" IsEnabled="{Binding SelectedJob.HasOutput, FallbackValue=False}" />
      <Button Content="Show report file" Command="{Binding RevealReportCommand}" CommandParameter="{Binding SelectedJob}" IsEnabled="{Binding SelectedJob.HasReport, FallbackValue=False}" />
      <Button Content="Rerun…" Command="{Binding RerunCommand}" CommandParameter="{Binding SelectedJob}" IsEnabled="{Binding SelectedJob.CanRerun, FallbackValue=False}" />
    </StackPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="True" GridLinesVisibility="Horizontal" AutomationProperties.Name="Job history">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Created" Binding="{Binding Created}" x:DataType="vm:JobRowViewModel" Width="150" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" x:DataType="vm:JobRowViewModel" Width="170" />
        <DataGridTextColumn Header="Source file" Binding="{Binding Source}" x:DataType="vm:JobRowViewModel" Width="*" />
        <DataGridTextColumn Header="Trigger" Binding="{Binding Trigger}" x:DataType="vm:JobRowViewModel" Width="90" />
        <DataGridTextColumn Header="Seen" Binding="{Binding Seen}" x:DataType="vm:JobRowViewModel" Width="80" />
        <DataGridTextColumn Header="Accepted" Binding="{Binding Accepted}" x:DataType="vm:JobRowViewModel" Width="90" />
        <DataGridTextColumn Header="Rejected" Binding="{Binding Rejected}" x:DataType="vm:JobRowViewModel" Width="90" />
        <DataGridTextColumn Header="Dupes" Binding="{Binding Duplicates}" x:DataType="vm:JobRowViewModel" Width="70" />
        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" x:DataType="vm:JobRowViewModel" Width="80" />
        <DataGridTextColumn Header="Job" Binding="{Binding ShortId}" x:DataType="vm:JobRowViewModel" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="4" Classes="card" Margin="0,12,0,0" IsVisible="{Binding SelectedReportText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ScrollViewer MaxHeight="260">
        <TextBlock FontFamily="Menlo,Consolas,monospace" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedReportText}" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
