<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinXmlProcessor.Desktop.ViewModels"
        xmlns:views="using:FinXmlProcessor.Desktop.Views"
        x:Class="FinXmlProcessor.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://FinXmlProcessor.Desktop/Assets/icon-256.png"
        Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:ProcessFileViewModel"><views:ProcessFileView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:QuarantineViewModel"><views:QuarantineView /></DataTemplate>
    <DataTemplate DataType="vm:ProfilesViewModel"><views:ProfilesView /></DataTemplate>
    <DataTemplate DataType="vm:DocumentationViewModel"><views:DocumentationView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="220,*" RowDefinitions="*,Auto">
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,16,16,12">
          <Image Source="avares://FinXmlProcessor.Desktop/Assets/icon-256.png" Width="40" Height="40" VerticalAlignment="Center" AutomationProperties.Name="FinXml Processor logo" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="FinXml Processor" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="XML to Excel, daily" FontSize="12" />
          </StackPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="8" AutomationProperties.Name="Main navigation">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:NavigationItem">
              <StackPanel Margin="4,2" AutomationProperties.Name="{Binding Title}">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" Grid.Row="0" Padding="20">
      <ContentControl Content="{Binding CurrentPage}" />
    </ScrollViewer>
    <Border Grid.Column="1" Grid.Row="1" Padding="12,6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressBar IsIndeterminate="{Binding Runner.IsBusy}" IsVisible="{Binding Runner.IsBusy}" Width="120" Height="6" AutomationProperties.Name="Job activity" />
        <TextBlock Text="{Binding Runner.StatusText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
